BLOB_READ_WRITE_TOKEN=
# Resend
RESEND_API_KEY=
# Payment gateway
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=
# Meta Pixel + Conversions API (Phase 3)
NEXT_PUBLIC_META_PIXEL_ID=
